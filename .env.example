# -- PostgreSQL --
POSTGRES_USER=flightops
POSTGRES_PASSWORD=flightops
POSTGRES_DB=flightops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Flask App --
SECRET_KEY=flightops-dev-secret-key-change-me
